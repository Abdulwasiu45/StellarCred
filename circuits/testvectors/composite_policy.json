      "operator": "NONE",
      "attributes": [
        "42",
        "0",
        "0",
        "0"
      ],
      "terms": [
        {
          "type": "MEMBERSHIP",
          "attribute": 0,
          "set": [
            "1",
            "2",
            "3"
          ],
          "negate": false
        },
        {
          "type": "MEMBERSHIP",
          "attribute": 0,
          "set": [
            "99",
            "100"
          ],
          "negate": false
        }
      ],
      "expected_result": true
    },
    {
      "name": "negated_term_and_combination",
      "description": "NOT (income < 50000) AND jurisdiction in set",
